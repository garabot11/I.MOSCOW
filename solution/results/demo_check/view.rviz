Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Detections1
    Tree Height: 420
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 10
      Plane Cell Count: 40
      Color: 60; 60; 80
      Reference Frame: <Fixed Frame>
      Plane: XY
      Offset:
        X: 0
        Y: -150
        Z: -1.3
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Lidar
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar_points
      Style: Points
      Size (Pixels): 2
      Alpha: 0.9
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: false
      Min Intensity: -2
      Max Intensity: 4
      Use rainbow: true
      Invert Rainbow: false
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Candidates (inside clearance box)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obstacles/candidates
      Style: Spheres
      Size (m): 0.35
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detections
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obstacles/markers
  Global Options:
    Background Color: 12; 12; 22
    Fixed Frame: hesai_lidar
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 75
      Focal Point:
        X: 0
        Y: -45
        Z: 0
      Pitch: 0.42
      Yaw: 1.5708
      Near Clip Distance: 0.1
      Target Frame: <Fixed Frame>
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  X: 40
  Y: 40
  Displays:
    collapsed: false
  Views:
    collapsed: true
