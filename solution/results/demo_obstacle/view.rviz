Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Lidar1
        - /Detections1
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 10
      Plane Cell Count: 60
      Color: 70; 70; 90
      Reference Frame: <Fixed Frame>
      Plane: XY
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Lidar
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /sensing/lidar/hesai128/pointcloud
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Use rainbow: true
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detections
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /obstacles/markers
  Global Options:
    Background Color: 15; 15; 25
    Fixed Frame: lidar_livox
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 160
      Focal Point:
        X: 0
        Y: -60
        Z: 0
      Pitch: 0.55
      Yaw: 1.5708
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 60
  Y: 40
  Displays:
    collapsed: false
  Views:
    collapsed: false
